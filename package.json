{
  "name": "artipen-demo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npm-run-all --parallel flask css watch",
    "flask": "gunicorn run:app -b 0.0.0.0:5555 -w 4 -k eventlet -t 600 --reload --log-level debug",
    "css": "npx tailwindcss -i ./app/static/css/tailwind.css -o ./app/static/css/tailwind-output.css --watch",
    "build": "vite build",
    "watch": "vite build --watch"
  },
