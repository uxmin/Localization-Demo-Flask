  "license": "ISC",
  "description": "",
  "dependencies": {
    "@tiptap/core": "^2.11.7",
    "@tiptap/pm": "^2.11.7",
    "@tiptap/starter-kit": "^2.11.7",
    "flowbite": "^3.1.2",
    "flowbite-typography": "^1.0.5",
    "npm-run-all": "^4.1.5",
    "sweetalert2": "^11.19.1",
    "tailwindcss": "^3.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3"
  }
}