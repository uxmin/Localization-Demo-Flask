{% extends "service/base.html.j2" %}
{% block notice %}
{% endblock notice %}
{% block subContent %}
  <div class="flex-1 space-y-6" name="workspace">
    <section class="px-6 py-10 duration-300 bg-white border border-l-8 shadow rounded-xl hover:border-l-orange-400"
             name="card"
             aria-label="1">
      <div>
        <h1 class="text-2xl font-medium opacity-50">1</h1>
        <h2 class="font-light">파일명이 담긴 엑셀 파일을 업로드하세요.</h2>
        <p class="text-sm text-sky-800">엑셀 파일의 첫 번째 열에는 반드시 헤더가 작성되어야 합니다.</p>
        <p class="text-sm text-sky-800">헤더는 숫자가 아닌 텍스트로 입력해주세요.</p>
      </div>
      <div class="mt-6">
        <input type="file"
               name="excel_file"
               accept=".xlsx, .xls"
               class="w-full rounded bg-stone-100 file:mr-3 file:border-none file:bg-sky-500 file:px-2 file:py-1 file:text-white file:duration-300 hover:file:bg-sky-400" />
      </div>
    </section>
    <section class="px-6 py-10 duration-300 bg-white border border-l-8 shadow rounded-xl hover:border-l-orange-400"
             name="card"
             aria-label="2">
      <div>
        <h1 class="text-2xl font-medium opacity-50">2</h1>
        <h2 class="font-light">업로드한 엑셀 파일에서 파일명이 적힌 헤더를 선택하세요.</h2>
        <p class="text-sm text-sky-800"></p>
      </div>
      <div class="mt-6">
        <select class="w-full px-2 py-1 rounded outline-none bg-stone-100">
          <option hidden>선택</option>
        </select>
      </div>
    </section>
    <section class="px-6 py-10 duration-300 bg-white border border-l-8 shadow rounded-xl hover:border-l-orange-400"
             name="card"
             aria-label="3">
      <div>
        <h1 class="text-2xl font-medium opacity-50">3</h1>
        <h2 class="font-light text-">추출할 디렉토리의 압축 파일을 업로드하세요.</h2>
        <p class="text-sm text-sky-800">현재는 zip 파일만 지원됩니다.</p>
      </div>
      <div class="mt-6">
        <input type="file"
               name="archive_file"
               accept=".zip"
               class="w-full rounded bg-stone-100 file:mr-3 file:border-none file:bg-sky-500 file:px-2 file:py-1 file:text-white file:duration-300 hover:file:bg-sky-400" />
      </div>
    </section>
    <section name="action">
      <button id="dwnbtn"
              class="px-4 py-2 text-white duration-300 bg-orange-400 rounded-lg hover:bg-orange-500">Download</button>
    </section>
  </div>
  <div class="flex-1" name="pannel"></div>
  {% set js_file_name = current_service.replace('-', '_') %}
  <script type="module"
          src="{{ url_for('static', filename='js/' + js_file_name + '.js') }}"></script>
{% endblock subContent %}
