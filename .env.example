# 애플리케이션 환경 변수 예시.
# 실제 값을 채운 뒤 `.env`로 복사해서 사용하세요. `.env`는 절대 커밋하지 않습니다.

# --- Flask ---
DEBUG=false
# 세션 서명 키. 운영에서는 반드시 충분히 긴 랜덤 값으로 고정하세요.
# 예) python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- 데모 접근 계정 (단일 계정 로그인) ---
AUTH_USERNAME=
AUTH_PASSWORD=

# --- CORS ---
# 허용할 origin을 쉼표로 구분. 비워두면 동일 출처만 허용합니다.
# 예) CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# --- OpenAI / LLM ---
OPENAI_API_KEY=
OPENAI_URL=

# --- 번역 시 마스킹할 보안 키워드 (쉼표 구분) ---
SECURITY_KEYWORDS=

# --- GitHub 연동 (Personal Access Token) ---
GITHUB_TOKEN=

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# --- Celery (Redis broker/backend) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- docker compose ---
PORT=8000
